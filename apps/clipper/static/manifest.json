{
  "manifest_version": 3,
  "name": "推理小说公开页面样本收藏",
  "description": "由用户主动保存当前公开页面的有限样本到本机工作台。",
  "version": "0.1.0",
  "incognito": "not_allowed",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "保存公开页面样本"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+Shift+Y"
      }
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; frame-src 'none';"
  }
}
