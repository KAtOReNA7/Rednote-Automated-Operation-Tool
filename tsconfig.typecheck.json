{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2022"],
    "noEmit": true,
    "paths": {
      "@mystery-operations/authenticity": ["./packages/authenticity/src/index.ts"],
      "@mystery-operations/catalog": ["./packages/catalog/src/index.ts"],
      "@mystery-operations/core": ["./packages/core/src/index.ts"],
      "@mystery-operations/clipper": ["./apps/clipper/src/index.ts"],
      "@mystery-operations/db": ["./packages/db/src/index.ts"],
      "@mystery-operations/dossier": ["./packages/dossier/src/index.ts"],
      "@mystery-operations/evidence": ["./packages/evidence/src/index.ts"],
      "@mystery-operations/experiments": ["./packages/experiments/src/index.ts"],
      "@mystery-operations/fetch": ["./packages/fetch/src/index.ts"],
      "@mystery-operations/local-api": ["./packages/local-api/src/index.ts"],
      "@mystery-operations/providers": ["./packages/providers/src/index.ts"],
      "@mystery-operations/search": ["./packages/search/src/index.ts"],
      "@mystery-operations/shared": ["./packages/shared/src/index.ts"],
      "@mystery-operations/shared/storage": ["./packages/shared/src/storage-contracts.ts"],
      "@mystery-operations/settings": ["./packages/settings/src/index.ts"],
      "@mystery-operations/storage": ["./packages/storage/src/index.ts"],
      "@mystery-operations/topics": ["./packages/topics/src/index.ts"],
      "@mystery-operations/workflows": ["./packages/workflows/src/index.ts"]
    },
    "types": ["node", "vite/client", "vitest/globals"]
  },
  "include": [
    "apps/**/*.ts",
    "apps/**/*.tsx",
    "packages/**/*.ts",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "vite.*.config.ts",
    "vitest.config.ts"
  ]
}
